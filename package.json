{
  "name": "sharedcut",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test src/state/store.test.ts src/services/*.test.ts server/*.test.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "start": "node --experimental-strip-types server/index.ts",
    "test:state": "node --experimental-strip-types --test src/state/store.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:realtime": "node --experimental-strip-types scripts/realtime-check.mjs",
    "test:presence": "node scripts/presence-check.mjs",
    "test:titles": "node scripts/titles-check.mjs",
    "test:compositions": "node scripts/compositions-check.mjs",
    "test:graphics": "node scripts/graphics-check.mjs",
    "test:media-scrub": "node scripts/media-scrub-check.mjs",
    "test:transitions": "node --experimental-strip-types scripts/transition-check.mjs",
    "import:resolve": "node scripts/import-resolve.mjs",
    "setup:captions": "python3.12 -m venv .venv-captions && .venv-captions/bin/pip install -r scripts/captions-requirements.txt && .venv-captions/bin/python scripts/transcribe.py --setup",
    "test:captions": "node --experimental-strip-types scripts/captions-check.mjs",
    "setup:imports": "python3.12 -m venv .venv-import && .venv-import/bin/pip install -r scripts/import-requirements.txt",
    "test:library": "node --experimental-strip-types scripts/library-check.mjs",
    "test:sfx": "node --experimental-strip-types --test server/sfx.test.ts",
    "import:sfx": "node --experimental-strip-types scripts/import-sfx.mjs",
    "test:color": "node scripts/color-gpu-check.mjs && node --experimental-strip-types scripts/color-overhaul-check.mjs && node --experimental-strip-types scripts/color-export-check.mjs",
    "setup:color": "python3 -m venv .venv-color && .venv-color/bin/pip install -r scripts/color-requirements.txt",
    "generate:color": ".venv-color/bin/python scripts/generate-aces.py",
    "test:color-reference": "node --experimental-strip-types scripts/color-reference-check.mjs && node --experimental-strip-types scripts/color-managed-browser-check.mjs && node --experimental-strip-types scripts/color-managed-export-check.mjs",
    "setup:masks": "python3.12 scripts/setup-masks.py",
    "test:masks": ".venv-mask/bin/python scripts/smart-mask-check.py && node --experimental-strip-types --test src/services/smartMask.test.ts server/smartMask.test.ts",
    "test:masks:browser": "node --experimental-strip-types scripts/smart-mask-browser-check.mjs",
    "setup:stabilize": "python3 scripts/setup-stabilize.py",
    "test:stabilize": "node --experimental-strip-types --test server/stabilize.test.ts src/services/stabilize.test.ts src/services/stabilizePreview.test.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.59.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
