{
  "name": "sharedcut",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test --test-concurrency=8 src/state/store.test.ts src/state/forwardSelect.test.ts src/services/*.test.ts server/*.test.ts",
    "dev:ui": "vite --host 0.0.0.0",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "test:state": "node --experimental-strip-types --test src/state/store.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "test:realtime": "node --experimental-strip-types scripts/realtime-check.mjs",
    "test:presence": "node scripts/presence-check.mjs",
    "test:titles": "node scripts/titles-check.mjs",
    "test:compositions": "node scripts/compositions-check.mjs",
    "test:graphics": "node scripts/graphics-check.mjs",
    "test:media-scrub": "node scripts/media-scrub-check.mjs",
    "test:transitions": "node --experimental-strip-types scripts/transition-check.mjs",
    "import:resolve": "node scripts/import-resolve.mjs",
    "setup:captions": "node scripts/setup-venv.mjs .venv-captions scripts/captions-requirements.txt scripts/transcribe.py --setup",
    "test:captions": "node --experimental-strip-types scripts/captions-check.mjs",
    "setup:imports": "node scripts/setup-venv.mjs .venv-import scripts/import-requirements.txt",
    "test:library": "node --experimental-strip-types scripts/library-check.mjs",
    "test:sfx": "node --experimental-strip-types --test server/sfx.test.ts",
    "import:sfx": "node --experimental-strip-types scripts/import-sfx.mjs",
    "test:color": "node scripts/color-gpu-check.mjs && node --experimental-strip-types scripts/color-overhaul-check.mjs && node --experimental-strip-types scripts/color-export-check.mjs",
    "setup:color": "node scripts/setup-venv.mjs .venv-color scripts/color-requirements.txt",
    "generate:color": "node scripts/venv-run.mjs .venv-color scripts/generate-aces.py",
    "test:color-reference": "node --experimental-strip-types scripts/color-reference-check.mjs && node --experimental-strip-types scripts/color-managed-browser-check.mjs && node --experimental-strip-types scripts/color-managed-export-check.mjs",
    "test:color-assistant": "node scripts/venv-run.mjs .venv-color scripts/color-assistant.py --selftest",
    "test:color-assistant:preview": "node --experimental-strip-types scripts/color-assistant-preview-check.mjs",
    "test:color-assistant:browser": "node --experimental-strip-types scripts/color-assistant-browser-check.mjs",
    "setup:masks": "node scripts/setup-venv.mjs .venv-mask scripts/mask-requirements.txt scripts/setup-masks.py",
    "test:masks": "node scripts/venv-run.mjs .venv-mask scripts/smart-mask-check.py && node --experimental-strip-types --test src/services/smartMask.test.ts server/smartMask.test.ts",
    "setup:depth": "node scripts/setup-venv.mjs .venv-mask scripts/mask-requirements.txt scripts/setup-depth.py",
    "test:depth": "node scripts/venv-run.mjs .venv-mask scripts/depth.py --selftest && node --experimental-strip-types --test src/services/depth.test.ts src/services/depthFx.test.ts src/services/depthPreview.test.ts server/depth.test.ts",
    "test:depth:browser": "node --experimental-strip-types --test src/components/depth.browser.test.ts",
    "test:depth:parity": "node scripts/depth-fx-check.mjs",
    "test:depth:inference": "node --experimental-strip-types scripts/depth-inference-check.mjs",
    "test:masks:browser": "node --experimental-strip-types scripts/smart-mask-browser-check.mjs",
    "test:optical-flow": "node --experimental-strip-types scripts/optical-flow-ffmpeg-check.mjs",
    "setup:stabilize": "node scripts/setup-venv.mjs .venv-stabilize scripts/stabilize-requirements.txt scripts/stabilize.py --check",
    "test:stabilize": "node --experimental-strip-types --test server/stabilize.test.ts src/services/stabilize.test.ts src/services/stabilizePreview.test.ts",
    "setup:flow": "node scripts/setup-venv.mjs .venv-flow scripts/optical-flow-requirements.txt scripts/optical-flow.py --check",
    "setup:tracker": "node scripts/setup-venv.mjs .venv-tracker scripts/tracker-requirements.txt scripts/tracker.py --check",
    "test:tracker": "node scripts/venv-run.mjs .venv-tracker scripts/tracker.py --selftest && node --experimental-strip-types --test src/services/motionTracker.test.ts server/motionTracker.test.ts",
    "test:tracker:browser": "node --experimental-strip-types scripts/motion-tracker-check.mjs",
    "test:optical-flow:browser": "node --experimental-strip-types scripts/optical-flow-check.mjs",
    "setup:windows": "node scripts/setup-windows.mjs",
    "doctor": "node --env-file-if-exists=.env --experimental-strip-types scripts/doctor.mjs",
    "test:masks:inference": "node --experimental-strip-types scripts/smart-mask-inference-check.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@napi-rs/canvas": "^1.0.9",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "mediabunny": "1.59.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.63.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.1"
  }
}
